<Window x:Class="desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktop"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="LightSteelBlue">

        <GroupBox Header="Dane osobowe" Height="180" HorizontalAlignment="Left" Margin="39,96,0,0" VerticalAlignment="Top" Width="320">

            <Grid Height="161" Margin="33,0,53,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="142"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Imie"></TextBlock>
                <TextBox x:Name="ImieTextBox" Grid.Column="1" Margin="10,2,-17,140" />
                <TextBlock Text="Nazwisko" Margin="0,28,0,-28"></TextBlock>
                <TextBox x:Name="NazwiskoTextBox" Grid.Column="1" Margin="10,28,-17,114" />
                <TextBlock Text="Stanowisko" Grid.ColumnSpan="2" Margin="0,53,142,-53"></TextBlock>
                <ComboBox x:Name="StanowiskoComboBox" Grid.Column="1" Margin="10,53,-17,89">

                    <ComboBoxItem Content="Kierownik">
                    </ComboBoxItem>
                    <ComboBoxItem Content="Starszy programista">
                    </ComboBoxItem>
                    <ComboBoxItem Content="Mlodszy Programista">
                    </ComboBoxItem>
                    <ComboBoxItem Content="Tester">
                    </ComboBoxItem>
                </ComboBox>

            </Grid>
        </GroupBox>




        <GroupBox Header="Generowanie hasla" Height="180" HorizontalAlignment="Left" Margin="444,96,0,0" VerticalAlignment="Top" Width="320">

            <Grid Height="161" Margin="33,0,53,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="142"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Ile znakow?"></TextBlock>
                <TextBox x:Name="IloscZnakow" Grid.Column="1" Margin="10,2,-17,140" />

                <CheckBox x:Name="CheckBoxMaleIWielkie" Content="Male i wielkie litery" Grid.ColumnSpan="2" Margin="0,28,142,-28" IsChecked="True"></CheckBox>
                <CheckBox x:Name="CheckBoxCyfry" Content="Cyfry" Margin="0,54,0,-54"/>
                <CheckBox x:Name="CheckBoxSpecjalne" Content="Znaki specjalne" Margin="0,80,0,-81"/>

                <Button x:Name="GenerujHasloButton" Content="Generuj haslo" Grid.ColumnSpan="2" Margin="60,108,119,27" Click="GenerujHasloButton_Click" Background="SteelBlue"></Button>
            </Grid>
        </GroupBox>
        <Button x:Name="ZatwierdzButton" Content="Zatwierdz" Margin="348,336,348,79" Click="ZatwierdzButton_Click" Background="SteelBlue"/>

    </Grid>
</Window>
